# Токен бота от @BotFather
BOT_TOKEN=

# Данные приложения с https://my.telegram.org (нужны Pyrogram для списка участников чата)
API_ID=
API_HASH=

# Админы панели /admin (имена участников, белый список чатов /summary): id через запятую. Пусто — панель выключена
ADMIN_IDS=

# Скачивание видео (TikTok, Instagram, YouTube Shorts, RedNote). false — оставить только /all
VIDEO_DOWNLOAD_ENABLED=true

# Сводка чата /summary: любой OpenAI-совместимый API. Пустой LLM_API_KEY — команда выключена
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
